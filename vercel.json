{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix server --omit=dev && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.js": { "maxDuration": 60, "memory": 1024, "includeFiles": "server/src/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" }
  ]
}
